<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- MENU PRINCIPAL -->
    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MASMORRAS"
            android:textSize="46sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:letterSpacing="0.18"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="8"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="RPG"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFCC80"
            android:letterSpacing="0.35"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Câmera e combate estilo Minecraft Dungeons"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"/>

        <View
            android:layout_width="140dp"
            android:layout_height="3dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="28dp"
            android:background="@color/primary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJogar"
            android:layout_width="240dp"
            android:layout_height="58dp"
            android:text="@string/jogar"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            style="@style/Widget.MaterialComponents.Button"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfig"
            android:layout_width="240dp"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:text="@string/configuracoes"
            app:cornerRadius="14dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </LinearLayout>

    <!-- SELEÇÃO DE CLASSE -->
    <LinearLayout
        android:id="@+id/classLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/escolher_classe"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvClasses"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoltarClasse"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/voltar"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
    </LinearLayout>

    <!-- JOGO -->
    <FrameLayout
        android:id="@+id/gameContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.viniciusy.masmorras.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- HUD estilo Dungeons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:background="#CC0A0E12">

            <TextView
                android:id="@+id/tvClasseHud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFCC80"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.08"/>

            <ProgressBar
                android:id="@+id/hpBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/hp_green"
                android:progressBackgroundTint="#33FFFFFF"/>

            <ProgressBar
                android:id="@+id/mpBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/mp_blue"
                android:progressBackgroundTint="#33FFFFFF"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Controles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Joystick área -->
            <FrameLayout
                android:id="@+id/joystickArea"
                android:layout_width="140dp"
                android:layout_height="140dp">
                <View
                    android:id="@+id/joystickBase"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@drawable/joystick_base"/>
                <View
                    android:id="@+id/joystickKnob"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/joystick_knob"/>
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Botões de ação -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnJump"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_marginEnd="10dp"
                    android:text="PULAR"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="31dp"
                    style="@style/Widget.MaterialComponents.Button"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoll"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_marginEnd="10dp"
                    android:text="ROLAR"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="31dp"
                    style="@style/Widget.MaterialComponents.Button"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAttack"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="ATK"
                android:textSize="16sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="40dp"
                style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Overlay fim de jogo -->
        <LinearLayout
            android:id="@+id/overlayFim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#CC000000"
            android:visibility="gone"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvFim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/accent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTentar"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="@string/tentar_novamente"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenu"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/menu"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
    </FrameLayout>

    <!-- CONFIGURAÇÕES -->
    <LinearLayout
        android:id="@+id/configLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/configuracoes"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerificarUpdate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/verificar_atualizacao"/>

        <TextView
            android:id="@+id/tvUpdateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:textSize="14sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="#33FFFFFF"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sobre"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="RPG top-down hack &amp; slash inspirado em Minecraft Dungeons.\n\nVersão do app usa o número do build do GitHub.\nAtualizações automáticas via Releases públicas."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoltarConfig"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/voltar"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
    </LinearLayout>

    <!-- NOVIDADES -->
    <ScrollView
        android:id="@+id/novidadesLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EE000000"
        android:visibility="gone"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/novidades"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvNovidades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFecharNovidades"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="Entendi!"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
