<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Masmorras" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">@font/pixel</item>
        <item name="alertDialogTheme">@style/Theme.Masmorras.Dialog</item>
    </style>

    <!-- Diálogos (renomear, excluir, novo mapa...) também em pedra -->
    <style name="Theme.Masmorras.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/panel_stone</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">#FFFFFF</item>
        <item name="colorAccent">@color/mc_gold</item>
        <item name="android:fontFamily">@font/pixel</item>
        <item name="buttonBarButtonStyle">@style/Mc.DialogButton</item>
    </style>

    <style name="Mc.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/mc_gold</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
