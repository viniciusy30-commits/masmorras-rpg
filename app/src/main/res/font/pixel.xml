<?xml version="1.0" encoding="utf-8"?>
<!-- Fonte pixel. O peso "bold" aponta para o mesmo arquivo para o Android não engrossar (negrito falso) os pixels. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:fontStyle="normal" android:fontWeight="400" android:font="@font/pixel_regular"
        app:fontStyle="normal" app:fontWeight="400" app:font="@font/pixel_regular"/>
    <font
        android:fontStyle="normal" android:fontWeight="700" android:font="@font/pixel_regular"
        app:fontStyle="normal" app:fontWeight="700" app:font="@font/pixel_regular"/>
    <font
        android:fontStyle="italic" android:fontWeight="400" android:font="@font/pixel_regular"
        app:fontStyle="italic" app:fontWeight="400" app:font="@font/pixel_regular"/>
    <font
        android:fontStyle="italic" android:fontWeight="700" android:font="@font/pixel_regular"
        app:fontStyle="italic" app:fontWeight="700" app:font="@font/pixel_regular"/>
</font-family>
